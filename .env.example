DATABASE_URL=postgres://eden:eden_dev@localhost:5433/eden_platform?sslmode=disable
SERVER_ADDR=:8080
# JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH were removed along with the
# dev/jwt key pair they pointed at. No code in this module reads either
# variable, and the private half was a real EC P-256 key committed to a
# public repo. Do not re-add a key file here: generate dev keys at runtime
# (platform/auth/saml.GenerateSigningKey) so nothing long-lived is committed.
NATS_URL=nats://localhost:4222
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eden-platform
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
