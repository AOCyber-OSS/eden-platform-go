# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build outputs from cmd/* entrypoints (root-relative, written by `go build ./cmd/foo`)
/aoid
/eden-platform-dev

# Test binary
*.test

# Output
*.out

# OpenSSL CA serial files — regenerated whenever fixtures are signed (see
# platform/mtls/piv/testdata/README.md). Never meant to be checked in.
*.srl

# Go workspace
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Generated

# DevFlow runtime state — these are session-local caches and skill markers,
# never meant to be committed. Planning artifacts under .planning/objectives/
# and .planning/quick/ ARE committed; only the dotfiles are ignored.
/.planning/.awareness-cache.json
/.planning/.skill-active

# Never commit developer key material. A real EC P-256 private key lived at
# dev/jwt/jwt_es256_private.pem and reached the public Go module proxy, where
# it cannot be withdrawn. Generate dev keys at runtime instead
# (platform/auth/saml.GenerateSigningKey).
#
# Deliberately scoped to dev/ rather than a blanket *.pem: platform/mtls/piv
# legitimately commits testdata certificates and a blanket rule would silently
# refuse new fixtures there.
dev/**/*.pem
dev/**/*.key
